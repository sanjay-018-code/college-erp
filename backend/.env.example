# Copy this file to backend/.env and fill in real values before deploying.
# NEVER commit the real .env file to version control.

# --- Django core ---
DJANGO_SECRET_KEY=CHANGE_ME_generate_with_get_random_secret_key
DJANGO_DEBUG=False
# CHANGE_ME: your server's domain/IP, comma separated, e.g. erp.yourcollege.edu,192.0.2.10
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database (must match docker-compose db service) ---
POSTGRES_DB=college_erp
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- CORS (only needed if frontend is served from a different origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Email (CHANGE_ME before enabling notice/email notifications) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME_app_password

# --- HTTPS hardening (enable once you have a real SSL certificate) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Optional: seed demo login accounts on first startup ---
SEED_DEMO_DATA=true
